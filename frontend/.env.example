# Copy to frontend/.env

# Relative path keeps dev same-origin through the Vite proxy (see vite.config.ts).
VITE_API_BASE_URL=/api/v1

# Empty = same origin (dev proxy). Set to http://localhost:4000 when the
# frontend is served from somewhere other than the Vite dev server.
VITE_SOCKET_URL=

# Alert sound is off by default so a demo room is not ambushed.
VITE_ALERT_SOUND_ENABLED=false
