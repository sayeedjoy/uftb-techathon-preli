{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SCS-RG backend \u2014 the sole authority for validation, risk fusion, incident lifecycle, priority ranking and actuation.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.eslint.json --noEmit",
    "lint": "eslint src scripts prisma",
    "lint:fix": "eslint src scripts prisma --fix",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx prisma/seed.ts",
    "seed:load": "tsx scripts/load-generator.ts",
    "db:explain": "tsx scripts/explain-hot-queries.ts",
    "sim:scenario": "tsx scripts/run-scenario.ts",
    "sim:load": "tsx scripts/run-load.ts",
    "ml:train": "tsx scripts/train-risk-model.ts",
    "docs:openapi": "tsx scripts/emit-openapi.ts",
    "retention": "tsx scripts/retention.ts",
    "print-zone-keys": "tsx scripts/print-zone-keys.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@scsrg/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.13.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10",
    "globals": "^17.7.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vitest": "^3.2.4"
  }
}
