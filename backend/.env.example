# ---------------------------------------------------------------------------
# SCS-RG backend configuration
# Every key below is parsed and validated by src/config/env.ts at boot.
# The process refuses to start on an invalid value.
# Copy to backend/.env and adjust.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Docker Compose binds Postgres to host port 5433 (a local psql 18 usually owns 5432).
DATABASE_URL=postgresql://scsrg:scsrg@localhost:5433/scsrg?schema=public
# Dedicated database used by the integration suite. Never point this at real data.
TEST_DATABASE_URL=postgresql://scsrg:scsrg@localhost:5433/scsrg_test?schema=public
# Prisma connection pool size (plan risk R7: the 30-zone load scenario).
DATABASE_POOL_SIZE=25

# Minimum 32 characters. Change for anything that is not a local demo.
JWT_SECRET=change-me-in-production-min-32-characters-long
JWT_EXPIRES_IN=60m
BCRYPT_ROUNDS=12

# Comma-separated allowlist. No wildcard is permitted with credentials.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# --- Risk fusion -----------------------------------------------------------
# riskScore = FIRE*fireSignal + GAS*gas + WATER*water + OCCUPANCY*occupancy
RISK_WEIGHT_FIRE=40
RISK_WEIGHT_GAS=25
RISK_WEIGHT_WATER=20
RISK_WEIGHT_OCCUPANCY=15
RISK_THRESHOLD_WARNING=30
RISK_THRESHOLD_CRITICAL=65
# Leaving CRITICAL requires score < (CRITICAL - HYSTERESIS) ...
STATE_HYSTERESIS=5
# ... for this many consecutive accepted readings.
RECOVERY_CONSECUTIVE_READINGS=3

# --- Sensor processing -----------------------------------------------------
FIRE_DEBOUNCE_CONSECUTIVE=5
FIRE_CLEAR_CONSECUTIVE=5
# 30000 in production; shortened for the demo without changing the logic.
GAS_WARMUP_MS=5000
OCCUPANCY_DEBOUNCE_READINGS=3
MAX_FUTURE_TIMESTAMP_SKEW_MS=5000

# --- Offline detection -----------------------------------------------------
ZONE_OFFLINE_TIMEOUT_MS=10000
ZONE_OFFLINE_SWEEP_MS=2000

# --- Priority ranking ------------------------------------------------------
PRIORITY_OCCUPANCY_BONUS=10
PRIORITY_DURATION_BONUS_MAX=10
PRIORITY_MULTI_HAZARD_BONUS=5
PRIORITY_ACKNOWLEDGED_PENALTY=15
PRIORITY_HUMAN_REPORT_BONUS_MAX=5

# --- Simulator -------------------------------------------------------------
SIM_DEFAULT_INTERVAL_MS=500
SIM_MAX_ZONES=40
SIM_INGESTION_BASE_URL=http://localhost:4000/api/v1

# --- Rate limits (requests per minute) -------------------------------------
RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_INGESTION_PER_MIN=1200

# --- Bonus features --------------------------------------------------------
TREND_WINDOW_READINGS=20
TREND_HORIZON_S=60
PREDICTION_ENABLED=true
# none = deterministic, offline extractor. No paid service is ever required.
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
