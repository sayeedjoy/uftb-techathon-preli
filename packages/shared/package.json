{
  "name": "@scsrg/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wire contract shared by the SCS-RG backend and frontend: domain enums, Zod schemas, API envelope and the Socket.IO event map.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "eslint": "^10",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vitest": "^3.2.4"
  }
}
